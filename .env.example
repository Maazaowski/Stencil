# Stencil Environment Configuration
# Copy to .env and fill in values

# Docker Compose project name. Without this, Compose derives the project (and
# so the container and volume names) from the checkout folder name.
COMPOSE_PROJECT_NAME=stencil

# General
ST_DEBUG=false
ST_LOG_LEVEL=INFO
ST_LOG_FORMAT=json

# Data directory (all subdirectories derived from this)
ST_DATA_DIR=stencil_data

# Database (MySQL).
#   - Local (non-Docker) runs: point at your local MySQL.
#   - Docker PROD (docker compose up): REQUIRED — set this to the production
#     MySQL. The base compose has no local DB; it reads this from .env.
#   - Docker DEV (docker compose -f docker-compose.yml -f docker-compose.dev.yml up):
#     leave as-is/ignored — the dev overlay starts a local MySQL and overrides this.
ST_DATABASE_URL=mysql+pymysql://stencil:stencil@localhost:3306/stencil

# Redis (Celery broker)
ST_REDIS_URL=redis://localhost:6379/0

# OpenAI API
ST_OPENAI_API_KEY=sk-your-key-here
ST_OPENAI_MODEL_CLASSIFICATION=gpt-5.5
ST_OPENAI_MODEL_EXTRACTION=gpt-5.5
ST_OPENAI_MODEL_MODEL_GENERATION=gpt-5.5
ST_OPENAI_MAX_RETRIES=3
ST_OPENAI_TIMEOUT=300
# Max completion tokens — must cover the model's reasoning AND the JSON output.
# Large multi-page invoices need a generous budget or the call returns empty.
ST_OPENAI_MAX_OUTPUT_TOKENS=32768
ST_AI_EXTRACTION_MODE=compact_chunked
ST_AI_CHUNK_MAX_LAYOUT_CHARS=24000
ST_AI_CHUNK_OVERLAP_ROWS=3
ST_AI_CHUNK_MAX_RETRIES=3
ST_AI_CHUNK_CONCURRENCY=1

# Extraction is text-first: the PDF text layer is the source of truth.
# Page images are only sent for pages with little/no text (scanned pages).
ST_EXTRACTION_SEND_PAGE_IMAGES=true
ST_EXTRACTION_MIN_PAGE_TEXT_CHARS=80
ST_EXTRACTION_IMAGE_DPI=150

# Model generation: number of attempts to build+validate a reusable model per
# AI extraction. 1 = single attempt; on failure the model is saved for manual
# review (not retried).
ST_MODEL_GENERATION_VALIDATION_ATTEMPTS=1

# Extraction thresholds
ST_CONFIDENCE_THRESHOLD=0.75
ST_MODEL_CONFIDENCE_THRESHOLD=0.80
ST_RECONCILIATION_VARIANCE_THRESHOLD=0.01

# File watcher
ST_WATCHER_POLL_INTERVAL=1.0
ST_WATCHER_STABLE_SECONDS=3.0

# Supplier profiles directory
ST_SUPPLIER_PROFILES_DIR=supplier_profiles

# Extraction models directory
ST_EXTRACTION_MODELS_DIR=extraction_models

# Login bootstrap — creates the FIRST admin user at startup while the users
# table is empty. Remove after first boot; users can be managed in-app later.
ST_ADMIN_EMAIL=
ST_ADMIN_PASSWORD=
# Login session lifetime (days)
ST_SESSION_TTL_DAYS=7
