# Stencil Docker Configuration
# Copy to .env before running: docker compose up -d

# ── REQUIRED ──────────────────────────────────────────────

# Your OpenAI API key (required for AI extraction)
ST_OPENAI_API_KEY=sk-your-key-here

# Production database (REQUIRED for `docker compose up`). The base compose has
# no local MySQL — it connects to whatever this points at. Not needed when
# running the dev overlay (docker-compose.dev.yml), which starts a local MySQL
# and overrides this value.
ST_DATABASE_URL=mysql+pymysql://USER:PASSWORD@PROD-MYSQL-HOST:3306/stencil

# ── OPTIONAL (defaults work for most setups) ─────────────

# Host directory where Stencil stores all data (PDFs, output XLSX/JSON, etc.)
# This folder will appear on your Windows machine with the completed output files.
# Default: C:\Stencil
ST_HOST_DATA_DIR=C:\Stencil

# Local MySQL passwords — used ONLY by the dev overlay (docker-compose.dev.yml).
# Ignored in production (no local DB there).
MYSQL_ROOT_PASSWORD=stencil
MYSQL_PASSWORD=stencil

# OpenAI models
ST_OPENAI_MODEL_CLASSIFICATION=gpt-4o-mini
ST_OPENAI_MODEL_EXTRACTION=gpt-4o
ST_AI_EXTRACTION_MODE=compact_chunked
ST_AI_CHUNK_MAX_LAYOUT_CHARS=24000
ST_AI_CHUNK_OVERLAP_ROWS=3
ST_AI_CHUNK_MAX_RETRIES=3
ST_AI_CHUNK_CONCURRENCY=1

# Extraction thresholds
ST_CONFIDENCE_THRESHOLD=0.75
ST_MODEL_CONFIDENCE_THRESHOLD=0.80
ST_RECONCILIATION_VARIANCE_THRESHOLD=0.01
